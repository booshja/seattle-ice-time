{
    "name": "seattle-ice-time",
    "version": "0.4.0",
    "private": true,
    "scripts": {
        "prepare": "husky",
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix --cache",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,md,mdx,css,scss,html,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,md,mdx,css,scss,html,yml,yaml}\"",
        "test": "vitest run",
        "test:ci": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "analyze": "ANALYZE=true next build",
        "change": "changeset && git add .changeset/",
        "change:version": "changeset version",
        "change:empty": "changeset add --empty && git add .changeset/",
        "release": "bun run change:version && git add -A && git commit -m \"chore: version packages\" && changeset tag && git push --follow-tags"
    },
    "dependencies": {
        "@aws-sdk/client-sesv2": "^3.995.0",
        "@emotion/cache": "^11.14.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@react-email/components": "^0.5.3",
        "@react-email/render": "^1.2.3",
        "@sentry/nextjs": "^10",
        "axios": "1.13.5",
        "next": "16.1.7",
        "next-plausible": "^3.12.4",
        "nodemailer": "7.0.11",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "zustand": "^5.0.8"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.9",
        "@emotion/jest": "^11.14.2",
        "@eslint/js": "^9.35.0",
        "@next/bundle-analyzer": "16",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.8.0",
        "@testing-library/react": "^16.3.0",
        "@types/node": "^24.3.3",
        "@types/nodemailer": "^7.0.1",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "@typescript-eslint/parser": "^8",
        "@vitest/coverage-v8": "^4.0.18",
        "eslint": "^9.35.0",
        "eslint-config-next": "^16",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-perfectionist": "^4",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-unused-imports": "^4.2.0",
        "eslint-plugin-vitest": "^0.5.4",
        "husky": "^9.1.7",
        "jsdom": "^28.1.0",
        "lint-staged": "^16.1.6",
        "prettier": "^3.6.2",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.43.0",
        "vitest": "^4.0.18"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,mjs,cjs}": [
            "eslint --fix --cache --format json",
            "prettier --write"
        ],
        "*.{json,md,mdx,css,scss,html,yml,yaml}": [
            "prettier --write"
        ]
    },
    "main": "index.js",
    "repository": "git@github.com:booshja/seattle-ice-time.git",
    "author": "Jacob Andes <jacob.andes@gmail.com>",
    "license": "MIT",
    "volta": {
        "node": "22.15.1"
    },
    "overrides": {
        "tar": ">=7.5.7",
        "@smithy/config-resolver": ">=4.4.6",
        "js-yaml": ">=3.14.2",
        "ansi-styles": "^6.2.1"
    },
    "trustedDependencies": [
        "@sentry/cli",
        "unrs-resolver"
    ]
}
